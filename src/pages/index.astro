    <!-- SLIDE 5 -->
    <section class="slide" data-slide="4">
      <div class="slide-content">
        <div class="fashion-badge">Слайд 05 / Бюджет</div>
        <h1 class="title-serif text-hero">Структура бюджета проекта по Фазам</h1>
        <p class="subtitle">Прозрачная калькуляция «под ключ» с фиксированной стоимостью Фазы 1</p>

        <div class="budget-layout">
          <div class="fashion-card budget-main">
            <h3 class="gold-gradient-text" style="font-size: 1.3rem; margin-bottom: 1rem;">
              ФАЗА 1: Тестовый Пилот (5–6 месяцев) — 5 460 000 ₽
            </h3>

            <div class="budget-grid">
              <div class="budget-item">
                <span class="b-title">Fashion UX/UI Дизайн (Figma UI-Kit)</span>
                <span class="b-val">780 000 ₽</span>
              </div>
              <div class="budget-item">
                <span class="b-title">Публичная витрина + ЛК Брендов + АРМ (Frontend)</span>
                <span class="b-val">1 620 000 ₽</span>
              </div>
              <div class="budget-item">
                <span class="b-title">Торговое ядро, База данных & OTP (Backend)</span>
                <span class="b-val">1 560 000 ₽</span>
              </div>
              <div class="budget-item">
                <span class="b-title">АРМ Стойки выдачи, Кассы 54-ФЗ & Честный ЗНАК</span>
                <span class="b-val">540 000 ₽</span>
              </div>
              <div class="budget-item">
                <span class="b-title">Проектное управление, Аналитика и QA (PM/BA)</span>
                <span class="b-val">660 000 ₽</span>
              </div>
