            </div>

            <div class="fashion-card side-card">
              <h4>ФАЗА 3: Экосистема</h4>
              <div class="side-price">2.43 – 3.60 млн ₽</div>
              <p>Flutter App (iOS/Android), ИИ-поиск, Доставка</p>
            </div>

            <div class="fashion-card side-card total-card">
              <h4>ОБЩИЙ ПОТЕНЦИАЛ</h4>
              <div class="side-price gold-gradient-text">9.33 – 12.60 млн ₽</div>
              <p>Полный комплекс фаз 1+2+3</p>
            </div>
          </div>
