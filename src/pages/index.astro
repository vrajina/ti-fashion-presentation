                <span class="b-val">300 000 ₽</span>
              </div>
            </div>
          </div>

          <div class="budget-sidebar">
            <div class="fashion-card side-card">
              <h4>ФАЗА 2: Масштабирование</h4>
              <div class="side-price">1.44 – 3.54 млн ₽</div>
