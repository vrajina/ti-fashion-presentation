    <!-- SLIDE 4 -->
    <section class="slide" data-slide="3">
      <div class="slide-content">
        <div class="fashion-badge">Слайд 04 / Финансовая Модель</div>
        <h1 class="title-serif text-hero">Юнит-экономика и финансовый потенциал</h1>
        <p class="subtitle">Расчет на основе базового трафика 45-50k визитов/мес и среднего чека 8 500 ₽</p>

        <!-- Desktop Table -->
        <div class="table-wrapper desktop-only">
          <table class="fashion-table">
            <thead>
