  <script>
    let currentSlide = 0;
    const slides = document.querySelectorAll('.slide');
    const totalSlides = slides.length;
    const currentSlideNum = document.getElementById('currentSlideNum');
    const progressFill = document.getElementById('progressFill');
    const btnPrev = document.getElementById('btnPrev');
    const btnNext = document.getElementById('btnNext');
    const btnFullscreen = document.getElementById('btnFullscreen');
    const btnExplore = document.getElementById('btnExplore');
    const tabBtns = document.querySelectorAll('.tab-btn');

    function goToSlide(index: number) {
      if (index < 0 || index >= totalSlides) return;

      slides[currentSlide].classList.remove('active');
      tabBtns[currentSlide]?.classList.remove('active');

      currentSlide = index;

      slides[currentSlide].classList.add('active');
      tabBtns[currentSlide]?.classList.add('active');
      (slides[currentSlide] as HTMLElement).scrollTop = 0;

      if (currentSlideNum) {
        currentSlideNum.textContent = String(currentSlide + 1).padStart(2, '0');
      }
      if (progressFill) {
        progressFill.style.width = `${((currentSlide + 1) / totalSlides) * 100}%`;
      }
    }

    btnExplore?.addEventListener('click', () => goToSlide(1));
    btnPrev?.addEventListener('click', () => goToSlide(currentSlide - 1));
    btnNext?.addEventListener('click', () => goToSlide(currentSlide + 1));

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-slide') || '0', 10);
        goToSlide(idx);
      });
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'PageDown' || e.key === ' ') {
        e.preventDefault();
        goToSlide(currentSlide + 1);
      } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
        e.preventDefault();
        goToSlide(currentSlide - 1);
      }
    });

    let isWheelThrottled = false;
    window.addEventListener('wheel', (e) => {
      const activeSlide = slides[currentSlide] as HTMLElement;
      if (!activeSlide) return;

      const isAtBottom = activeSlide.scrollTop + activeSlide.clientHeight >= activeSlide.scrollHeight - 8;
      const isAtTop = activeSlide.scrollTop <= 8;

      if (e.deltaY > 0 && isAtBottom && currentSlide < totalSlides - 1) {
        e.preventDefault();
        if (!isWheelThrottled) {
          isWheelThrottled = true;
          goToSlide(currentSlide + 1);
          setTimeout(() => { isWheelThrottled = false; }, 400);
        }
      } else if (e.deltaY < 0 && isAtTop && currentSlide > 0) {
        e.preventDefault();
        if (!isWheelThrottled) {
          isWheelThrottled = true;
          goToSlide(currentSlide - 1);
          setTimeout(() => { isWheelThrottled = false; }, 400);
        }
      }
    }, { passive: false });

    btnFullscreen?.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    });

    let touchStartX = 0;
    let touchStartY = 0;
    let touchEndX = 0;
    let touchEndY = 0;
    const deckContainer = document.querySelector('.deck-container');

    deckContainer?.addEventListener('touchstart', (e: any) => {
      touchStartX = e.changedTouches[0].screenX;
      touchStartY = e.changedTouches[0].screenY;
    }, { passive: true });

    deckContainer?.addEventListener('touchend', (e: any) => {
      touchEndX = e.changedTouches[0].screenX;
      touchEndY = e.changedTouches[0].screenY;
      const diffX = touchEndX - touchStartX;
      const diffY = touchEndY - touchStartY;
      if (Math.abs(diffX) > 50 && Math.abs(diffX) > Math.abs(diffY)) {
        if (diffX < 0) goToSlide(currentSlide + 1);
        else goToSlide(currentSlide - 1);
      }
    }, { passive: true });
  </script>
