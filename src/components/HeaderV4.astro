---
export interface Props {
  totalSlides?: number;
}

const { totalSlides = 10 } = Astro.props;
---

<header class="header-v4">
  <div class="brand-group">
    <a href="/" title="Trend Island Presentation" style="text-decoration: none; color: inherit; display: flex; align-items: center; gap: 8px;">
      <span style="font-family: var(--font-title); font-weight: 500; font-size: 0.95rem; letter-spacing: 0.12em;" class="nobr">TREND ISLAND</span>
      <span style="color: var(--text-light); font-size: 0.8rem;">x</span>
      <span style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted);" class="nobr">E-COMMERCE</span>
    </a>
  </div>

  <div class="header-controls">
    <div class="slide-indicator">
      <span class="current" id="currentSlideNum">01</span>
      <span class="sep">/</span>
      <span class="total">{String(totalSlides).padStart(2, '0')}</span>
    </div>

    <div class="nav-buttons">
      <button id="btnPrev" class="icon-btn" title="Предыдущий слайд (←)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button id="btnNext" class="icon-btn" title="Следующий слайд (→)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      </button>
      <button id="btnFullscreen" class="icon-btn" title="На весь экран">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
      </button>
    </div>
  </div>
</header>

<div class="progress-bar-v4">
  <div class="progress-fill-v4" id="progressFill"></div>
</div>

<style>
  .header-v4 {
    position: relative;
    z-index: 10;
    height: 65px;
    padding: 0 3.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    border-bottom: 1px solid var(--border-color);
  }

  .brand-group {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .header-controls {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .slide-indicator {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-main);
    display: flex;
    align-items: center;
    gap: 3px;
  }

  .slide-indicator .sep {
    color: var(--text-light);
  }

  .nav-buttons {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .icon-btn {
    background: #ffffff;
    border: 1px solid var(--border-color);
    color: var(--text-main);
    width: 36px;
    height: 36px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .icon-btn:hover {
    background: #111111;
    color: #ffffff;
    border-color: #111111;
  }

  .progress-bar-v4 {
    position: relative;
    z-index: 10;
    width: 100%;
    height: 3px;
    background: #ebebeb;
  }

  .progress-fill-v4 {
    height: 100%;
    width: 10%;
    background: var(--text-main);
    transition: width 0.3s ease-out;
  }

  @media (max-width: 768px) {
    .header-v4 {
      padding: 0 1.25rem;
      height: 60px;
    }
  }
</style>
