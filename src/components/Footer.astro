---
export interface Props {
  totalSlides?: number;
}

const { totalSlides = 7 } = Astro.props;

const slideTitles = [
  "1. Боль бизнеса & Ядро",
  "2. Стратегические задачи",
  "3. Этапы и фазы пилота",
  "4. Юнит-экономика",
  "5. Бюджет по фазам",
  "6. Преимущества",
  "7. Следующие шаги"
];
---

<footer class="footer">
  <div class="keyboard-hint">
    <span>Навигация:</span>
    <kbd>←</kbd> <kbd>→</kbd>
    <span class="muted">или клик по табам</span>
  </div>

  <div class="slide-tabs">
    {slideTitles.map((title, idx) => (
      <button class={`tab-btn ${idx === 0 ? 'active' : ''}`} data-slide={idx}>
        {title}
      </button>
    ))}
  </div>

  <div class="copyright">
    TREND ISLAND © 2026
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 10;
    height: 50px;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(10, 10, 14, 0.95);
    border-top: 1px solid rgba(212, 175, 55, 0.1);
    font-size: 0.75rem;
  }

  .keyboard-hint {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
  }

  .keyboard-hint kbd {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border-gold);
    border-radius: 4px;
    padding: 2px 6px;
    font-family: var(--font-mono);
    color: var(--accent-gold-bright);
    font-size: 0.7rem;
  }

  .keyboard-hint .muted {
    color: var(--text-dim);
    margin-left: 4px;
  }

  .slide-tabs {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    overflow-x: auto;
    max-width: 60%;
  }

  .tab-btn {
    background: transparent;
    border: 1px solid transparent;
    color: var(--text-muted);
    padding: 0.3rem 0.65rem;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .tab-btn:hover {
    color: var(--text-white);
    background: rgba(255, 255, 255, 0.04);
  }

  .tab-btn.active {
    background: rgba(212, 175, 55, 0.12);
    border-color: var(--border-gold);
    color: var(--accent-gold-bright);
    font-weight: 600;
  }

  .copyright {
    color: var(--text-dim);
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
  }

  @media (max-width: 900px) {
    .keyboard-hint, .copyright {
      display: none;
    }
    .slide-tabs {
      max-width: 100%;
      width: 100%;
      justify-content: center;
    }
  }
</style>
