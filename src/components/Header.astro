---
import TILogo from './TILogo.astro';

export interface Props {
  totalSlides?: number;
}

const { totalSlides = 7 } = Astro.props;
---

<header class="header">
  <TILogo size={38} />

  <div class="header-nav">
    <div class="slide-indicator">
      <span class="current" id="currentSlideNum">01</span>
      <span class="sep">/</span>
      <span class="total">{String(totalSlides).padStart(2, '0')}</span>
    </div>

    <div class="nav-controls">
      <button id="btnPrev" class="nav-btn" title="Предыдущий слайд (←)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button id="btnNext" class="nav-btn" title="Следующий слайд (→)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      </button>
      <button id="btnFullscreen" class="nav-btn highlight" title="На весь экран">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
      </button>
    </div>
  </div>
</header>

<!-- Progress Bar -->
<div class="progress-bar-container">
  <div class="progress-bar-fill" id="progressFill"></div>
</div>

<style>
  .header {
    position: relative;
    z-index: 10;
    height: 70px;
    padding: 0 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(10, 10, 14, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(212, 175, 55, 0.15);
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .slide-indicator {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .slide-indicator .current {
    color: var(--accent-gold-bright);
    font-size: 1.2rem;
  }

  .slide-indicator .sep {
    color: var(--text-dim);
  }

  .slide-indicator .total {
    color: var(--text-muted);
  }

  .nav-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-btn {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(212, 175, 55, 0.2);
    color: var(--text-white);
    width: 38px;
    height: 38px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .nav-btn:hover {
    background: rgba(212, 175, 55, 0.15);
    border-color: var(--accent-gold);
    color: var(--accent-gold-bright);
    transform: translateY(-1px);
  }

  .nav-btn.highlight {
    background: rgba(212, 175, 55, 0.1);
    border-color: var(--border-gold);
  }

  .progress-bar-container {
    position: relative;
    z-index: 10;
    width: 100%;
    height: 3px;
    background: rgba(255, 255, 255, 0.05);
  }

  .progress-bar-fill {
    height: 100%;
    width: 14.28%;
    background: linear-gradient(90deg, var(--accent-gold) 0%, #fff7d6 100%);
    transition: width 0.3s ease-out;
    box-shadow: 0 0 10px rgba(212, 175, 55, 0.5);
  }

  @media (max-width: 768px) {
    .header {
      padding: 0 1.25rem;
      height: 60px;
    }
  }
</style>
