---
export interface Props {
  totalSlides?: number;
}

const { totalSlides = 10 } = Astro.props;

const slideTitles = [
  "1. Титул",
  "2. Ограничения",
  "3. Барьеры онлайна",
  "4. Lean MVP & Решение",
  "5. Бизнес-ценность",
  "6. Схема Фаз",
  "7. Сроки и Бюджет",
  "8. Команда & AI Stack",
  "9. Юнит-экономика",
  "10. Регламент старта"
];
---

<footer class="footer-v4">
  <div class="keyboard-hint">
    <span>Навигация</span>
    <kbd>←</kbd>
    <kbd>→</kbd>
    <span class="hint-sep">·</span>
    <span>колесо</span>
  </div>

  <div class="slide-tabs">
    {slideTitles.map((title, idx) => (
      <button class={`tab-btn ${idx === 0 ? 'active' : ''}`} data-slide={idx}>
        {title}
      </button>
    ))}
  </div>

  <div class="copyright">
    TREND ISLAND × E-COMMERCE · 2026
  </div>
</footer>

<style>
  .footer-v4 {
    position: relative;
    z-index: 10;
    height: 48px;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    border-top: 1px solid var(--border-color, #d4d0c7);
    font-size: 0.74rem;
    box-shadow: 0 -1px 0 rgba(10, 10, 10, 0.02);
  }

  .keyboard-hint {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted, #4f4c47);
    white-space: nowrap;
  }

  .hint-sep {
    opacity: 0.45;
    margin: 0 2px;
  }

  .keyboard-hint kbd {
    background: #f3f1ec;
    border: 1px solid #d4d0c7;
    border-radius: 3px;
    padding: 2px 7px;
    font-family: var(--font-mono);
    color: var(--text-main, #0a0a0a);
    font-weight: 600;
    font-size: 0.7rem;
  }

  .slide-tabs {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    overflow-x: auto;
    max-width: 62%;
    scrollbar-width: none;
  }

  .slide-tabs::-webkit-scrollbar {
    display: none;
  }

  .tab-btn {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--text-light, #7a756c);
    padding: 0.45rem 0.55rem;
    border-radius: 0;
    font-size: 0.7rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.18s ease, border-color 0.18s ease;
    font-family: var(--font-body);
  }

  .tab-btn:hover {
    color: var(--text-main, #0a0a0a);
  }

  .tab-btn.active {
    background: transparent;
    color: var(--text-main, #0a0a0a);
    border-bottom-color: var(--text-main, #0a0a0a);
    font-weight: 650;
  }

  .copyright {
    color: var(--text-light, #7a756c);
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
    font-size: 0.68rem;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .keyboard-hint, .copyright {
      display: none;
    }
    .slide-tabs {
      max-width: 100%;
      width: 100%;
      justify-content: flex-start;
    }
    .footer-v4 {
      padding: 0 0.75rem;
    }
  }
</style>
